[Unit]
Description=RustWallpaper Screen Saver
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/RustWallpaper --service
# kill --tray and --server both
ExecStop=pkill -f "RustWallpaper --"
# kill --tray and --server both
#ExecStop=pkill -f "RustWallpaper --tray"
#ExecStop=pkill -f "RustWallpaper --server"
PIDFile=/run/rustdesk.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target
